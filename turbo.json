{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"test:ci": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test:cov": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"@nodejs-order-book/core#test": {
			"dependsOn": ["@nodejs-order-book/plugin-journaling#build"]
		},
		"@nodejs-order-book/core#test:ci": {
			"dependsOn": ["@nodejs-order-book/plugin-journaling#build"]
		},
		"@nodejs-order-book/core#test:cov": {
			"dependsOn": ["@nodejs-order-book/plugin-journaling#build"]
		},
		"lint": {
			"outputs": []
		},
		"lint:fix": {
			"outputs": []
		},
		"clean": {
			"cache": false
		},
		"bench": {
			"dependsOn": ["^build"],
			"outputs": []
		}
	}
}
